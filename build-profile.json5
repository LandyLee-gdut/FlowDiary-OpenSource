{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.1.0(23)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      { "name": "debug" },
      { "name": "release" }
    ],
    "capabilities": [
      {
        "bundleName": "com.landylee.flowdiary",
        "config": [
          {
            "capability": "com.huawei.service.push.base_service",
            "name": "Push Kit"
          }
        ]
      }
    ]
  },
  "modules": [
    { "name": "today", "srcPath": "./features/today", "targets": [{ "name": "default", "applyToProducts": ["default"] }] },
    { "name": "reflect", "srcPath": "./features/reflect", "targets": [{ "name": "default", "applyToProducts": ["default"] }] },
    { "name": "ideapool", "srcPath": "./features/ideapool", "targets": [{ "name": "default", "applyToProducts": ["default"] }] },
    { "name": "base", "srcPath": "./common/base" },
    { "name": "phone", "srcPath": "./products/phone", "targets": [{ "name": "default", "applyToProducts": ["default"] }] }
  ]
}
